{
  "name": "ts-module-commercial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4175 --strictPort",
    "test": "node --test src/services/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "ci": "npm test && npm run build && npm run check:bundle"
  },
  "bundleBudget": {
    "js": { "bytes": 520000, "gzipBytes": 170000 },
    "css": { "bytes": 100000, "gzipBytes": 20000 },
    "remoteEntry": { "bytes": 25000, "gzipBytes": 8000 }
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@internationalized/date": "^3.12.3",
    "@thiagoschoeffel/ts-components": "^0.7.10",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.1.5"
  }
}
